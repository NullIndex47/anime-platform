{
  "name": "anime-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && node --import tsx scripts/deploy-production.ts",
    "test": "npm run moderation:check && node --import tsx --test --test-isolation=none src/services/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:worker": "E2E_SERVER=worker playwright test",
    "moderation:generate": "node --import tsx scripts/generate-username-moderation.ts",
    "moderation:check": "node --import tsx scripts/generate-username-moderation.ts --check",
    "deploy:preview": "node --import tsx scripts/deploy-preview.ts",
    "phase3e:backup": "node --import tsx scripts/phase3e-backup.ts",
    "preview:dry-run": "node --import tsx scripts/deploy-preview.ts --dry-run",
    "production:dry-run": "node --import tsx scripts/deploy-production.ts --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.149.0"
  }
}
